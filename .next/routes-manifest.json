{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin-dashboard",
      "regex": "^/admin\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-dashboard(?:/)?$"
    },
    {
      "page": "/employee-dashboard",
      "regex": "^/employee\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/employee\\-dashboard(?:/)?$"
    },
    {
      "page": "/inventory",
      "regex": "^/inventory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inventory(?:/)?$"
    },
    {
      "page": "/items",
      "regex": "^/items(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/items(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/manager-dashboard",
      "regex": "^/manager\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manager\\-dashboard(?:/)?$"
    },
    {
      "page": "/notification",
      "regex": "^/notification(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/notification(?:/)?$"
    },
    {
      "page": "/purchases",
      "regex": "^/purchases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/purchases(?:/)?$"
    },
    {
      "page": "/report",
      "regex": "^/report(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/report(?:/)?$"
    },
    {
      "page": "/sales",
      "regex": "^/sales(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sales(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/transactions",
      "regex": "^/transactions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/transactions(?:/)?$"
    },
    {
      "page": "/users",
      "regex": "^/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/users(?:/)?$"
    }
