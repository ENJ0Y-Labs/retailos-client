# Browser requests use the same-origin /api proxy.
# Set the upstream Flask API origin in the Next.js runtime environment.
RETAILOS_API_ORIGIN=http://127.0.0.1:5000

# Public business WhatsApp number in international format, digits only (example format: 2348012345678).
# Leave empty until the official Premium support number is ready.
NEXT_PUBLIC_PREMIUM_SUPPORT_WHATSAPP_NUMBER=
