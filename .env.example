# PostgreSQL connection string. Use your managed PostgreSQL provider URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/retailos
# Optional: set to false for a local non-TLS PostgreSQL instance.
DATABASE_SSL=true
# Long random secret used to sign RetailOS login sessions.
AUTH_SECRET=replace-with-a-long-random-secret
# One-time key used by POST /api/setup to create the first ADMIN user.
SETUP_KEY=replace-with-a-long-random-setup-key
